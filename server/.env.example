# Copy this file to ".env" (in the server folder) and fill it in.
# ".env" is git-ignored, so your password never gets committed.

PORT=5001

# Where contact-form messages are delivered
CONTACT_TO=mdsamielbashar@gmail.com

# SMTP account used to SEND the email.
# For Gmail: turn on 2-step verification, then create an "App password"
# (Google Account > Security > App passwords) and paste it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=mdsamielbashar@gmail.com
SMTP_PASS=your-16-character-app-password

# Only needed if the React site is hosted somewhere ELSE than this server
# (for example GitHub Pages). Comma-separated list of allowed origins.
# CLIENT_ORIGIN=https://rhythm162k.github.io
