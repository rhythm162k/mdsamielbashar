// Cloudflare config: one Worker that serves the React site AND the /api routes.
{
  "name": "mdsamielbashar", // must match the Worker name in the Cloudflare dashboard (it becomes mdsamielbashar.<your-subdomain>.workers.dev)
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",

  "assets": {
    "directory": "./client/dist",
    // Only /api/* runs the Worker code. Everything else is served as a plain file (free and unlimited).
    "run_worker_first": ["/api/*"]
  },

  // Not secret, so they can live in the repo. The secret RESEND_API_KEY is set separately.
  "vars": {
    "CONTACT_TO": "mdsamielbashar@gmail.com",
    "MAIL_FROM": "Portfolio contact form <onboarding@resend.dev>"
  },

  "observability": { "enabled": true }
}
